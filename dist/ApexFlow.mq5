   int               londonEndMin;
   bool              enableNewYork;
   int               newYorkStartMin;
   int               newYorkEndMin;
   bool              enableOverlap;
   int               noEntryBeforeEndMin;
   // strategy
   ENUM_APEX_ACTIVITY activityProfile;
